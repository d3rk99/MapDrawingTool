<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Map Drawing Tool: makes the four vanilla pens spawn (vanilla types.xml has them at nominal 0,
     so they never appear). Drawing in game needs a pen. Works on Chernarus, Livonia, Sakhal, Nasdara.
     Install: see README.txt next to this file. -->
<types>
    <type name="Pen_Black">
        <nominal>6</nominal>
        <lifetime>28800</lifetime>
        <restock>0</restock>
        <min>3</min>
        <quantmin>-1</quantmin>
        <quantmax>-1</quantmax>
        <cost>100</cost>
        <flags count_in_cargo="0" count_in_hoarder="0" count_in_map="1" count_in_player="0" crafted="0" deloot="0"/>
        <category name="tools"/>
        <tag name="shelves"/>
        <usage name="Town"/>
        <usage name="Village"/>
        <usage name="Office"/>
    </type>
